.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 36rpx;
  background: var(--sp-muted-bg);
  color: var(--sp-muted);
}
.badge__dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: currentColor;
}
.badge--success { background: var(--sp-success-bg); color: var(--sp-success); }
.badge--info { background: var(--sp-info-bg); color: var(--sp-info); }
.badge--warning { background: var(--sp-warning-bg); color: var(--sp-warning); }
.badge--danger { background: var(--sp-danger-bg); color: var(--sp-danger); }
