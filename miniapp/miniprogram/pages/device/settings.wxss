.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 64rpx;
  box-sizing: border-box;
}
.card {
  margin-bottom: 24rpx;
  padding: 16rpx 32rpx 32rpx;
  border-radius: 24rpx;
  background: #fff;
}
.field {
  margin-top: 16rpx;
}
.field__label {
  color: var(--sp-text-secondary);
  font-size: 26rpx;
}
.field__input {
  height: 80rpx;
  margin-top: 12rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--sp-border);
  border-radius: 16rpx;
}
.notice {
  margin-top: 16rpx;
  color: var(--sp-warning);
  font-size: 26rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  padding-top: 20rpx;
  font-size: 28rpx;
}
.row__label {
  color: var(--sp-text-secondary);
}
.mono {
  font-family: Menlo, monospace;
}
.danger {
  color: var(--sp-danger);
}
.btn {
  margin-top: 24rpx;
  border-radius: 48rpx;
  background: #fff !important;
  color: var(--sp-text) !important;
}
.btn--primary {
  background: var(--sp-primary) !important;
  color: #fff !important;
}
.btn--small {
  margin-top: 32rpx;
}
.btn--danger-text {
  margin-top: 48rpx;
  color: var(--sp-danger) !important;
}
