<view class="page">
  <view class="filter">
    <picker mode="date" value="{{date || today}}" end="{{today}}" bindchange="onPickDate">
      <view class="filter__date {{date ? 'filter__date--on' : ''}}">{{date || '选择日期'}}</view>
    </picker>
    <view class="filter__all {{date ? '' : 'filter__all--on'}}" bindtap="onAllDates">全部</view>
  </view>
  <view class="hint">{{isOwner ? '含遥控器、地感等现场操作；带“约”的时间为设备定时上报时发现的' : '只显示你本人的操作'}}</view>

  <view wx:if="{{loading}}" class="placeholder">加载中…</view>
  <view wx:elif="{{error}}" class="placeholder" bindtap="reload">{{error}}，点击重试</view>
  <view wx:elif="{{empty}}" class="placeholder">{{empty}}</view>
  <block wx:else>
    <view wx:for="{{sections}}" wx:for-item="section" wx:key="key" class="section">
      <view class="section__title">{{section.label}}</view>
      <view class="list">
        <view wx:for="{{section.rows}}" wx:key="id" class="row">
          <view class="row__time">{{item.time}}</view>
          <view class="row__main">
            <view class="row__title">
              <text class="row__action">{{item.action}}</text>
              <text wx:if="{{item.role}}" class="row__role">{{item.role}}</text>
            </view>
            <view class="row__who">{{item.who}}</view>
          </view>
          <view class="row__result">
            <view wx:if="{{item.result}}" class="tone--{{item.tone}}">{{item.result}}</view>
            <view wx:if="{{item.duration}}" class="row__duration">{{item.duration}}</view>
          </view>
        </view>
      </view>
    </view>
    <view class="more">{{loadingMore ? '加载中…' : more ? '上拉加载更多' : '没有更多了'}}</view>
  </block>
</view>
