.device {
  min-height: 100vh;
  padding: 24rpx 32rpx 64rpx;
  box-sizing: border-box;
}
.device__stale {
  margin-bottom: 16rpx;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: var(--sp-warning-bg);
  color: var(--sp-warning);
  font-size: 24rpx;
}
.device__head {
  margin-bottom: 24rpx;
}
.device__title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.device__title {
  font-size: 40rpx;
  font-weight: 600;
}
.device__role {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--sp-muted-bg);
  color: var(--sp-text-secondary);
  font-size: 22rpx;
}
.device__subtitle {
  margin-top: 8rpx;
  color: var(--sp-text-secondary);
  font-size: 26rpx;
}
.device__badge {
  margin-left: auto;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}
.device__badge--success { background: var(--sp-success-bg); color: var(--sp-success); }
.device__badge--info { background: var(--sp-info-bg); color: var(--sp-info); }
.device__badge--warning { background: var(--sp-warning-bg); color: var(--sp-warning); }
.device__badge--danger { background: var(--sp-danger-bg); color: var(--sp-danger); }
.device__badge--muted { background: var(--sp-muted-bg); color: var(--sp-muted); }

/* 闸杆图示：立柱 + 闸杆，抬杆为竖起，落杆为放平 */
.gate {
  position: relative;
  height: 320rpx;
  border-radius: 24rpx;
  background: #fff;
  overflow: hidden;
}
.gate__post {
  position: absolute;
  left: 96rpx;
  bottom: 64rpx;
  width: 48rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background: var(--sp-text-secondary);
}
.gate__arm {
  position: absolute;
  left: 120rpx;
  bottom: 160rpx;
  width: 440rpx;
  height: 20rpx;
  margin-top: -10rpx;
  border-radius: 10rpx;
  background: repeating-linear-gradient(90deg, var(--sp-danger) 0 40rpx, #fff 40rpx 80rpx);
  transform-origin: 0 50%;
  transition: transform 1.2s ease-in-out;
}
.gate__arm--closed { transform: rotate(0deg); }
.gate__arm--opened { transform: rotate(-80deg); }
.gate__arm--unknown { transform: rotate(-40deg); opacity: 0.5; }
.gate__arm--opening { animation: gate-open 1.2s ease-in-out infinite alternate; }
.gate__arm--closing { animation: gate-close 1.2s ease-in-out infinite alternate; }
@keyframes gate-open {
  from { transform: rotate(0deg); }
  to { transform: rotate(-80deg); }
}
@keyframes gate-close {
  from { transform: rotate(-80deg); }
  to { transform: rotate(0deg); }
}
.gate__label {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.device__stats {
  display: flex;
  margin-top: 24rpx;
  padding: 24rpx 0;
  border-radius: 24rpx;
  background: #fff;
}
.stat {
  flex: 1;
  text-align: center;
}
.stat__label {
  color: var(--sp-text-secondary);
  font-size: 24rpx;
}
.stat__value {
  display: flex;
  justify-content: center;
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 500;
}
.device__refreshed {
  margin-top: 12rpx;
  color: var(--sp-muted);
  font-size: 22rpx;
  text-align: right;
}

.device__result {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  text-align: center;
}
.device__result--info { background: var(--sp-info-bg); color: var(--sp-info); }
.device__result--success { background: var(--sp-success-bg); color: var(--sp-success); }
.device__result--warning { background: var(--sp-warning-bg); color: var(--sp-warning); }
.device__result--danger { background: var(--sp-danger-bg); color: var(--sp-danger); }

.device__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 32rpx;
}
.action {
  flex: 1;
  height: 112rpx;
  margin: 0 !important;
  border-radius: 56rpx;
  background: #fff !important;
  color: var(--sp-primary) !important;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 112rpx;
}
.action--primary {
  background: var(--sp-primary) !important;
  color: #fff !important;
}
.action--wide {
  flex-basis: 100%;
}
.action[disabled] {
  opacity: 0.6;
}
.device__reason {
  width: 100%;
  color: var(--sp-text-secondary);
  font-size: 26rpx;
  text-align: center;
}
.device__reason--block {
  padding: 32rpx 24rpx;
  border-radius: 16rpx;
  background: #fff;
}
.device__support {
  width: 100%;
  border-radius: 48rpx;
  background: var(--sp-muted-bg) !important;
  color: var(--sp-text) !important;
}

.device__last {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 40rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff;
}
.device__last-label {
  color: var(--sp-text-secondary);
  font-size: 24rpx;
}
.device__last-more {
  margin-left: auto;
  color: var(--sp-primary);
  font-size: 24rpx;
}
.device__last-text {
  order: 3;
  width: 100%;
  margin-top: 8rpx;
  font-size: 28rpx;
}
