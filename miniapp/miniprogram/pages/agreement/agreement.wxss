.doc {
  padding: 32rpx 40rpx 80rpx;
  background: #fff;
  min-height: 100vh;
  box-sizing: border-box;
}
.doc__draft {
  margin-bottom: 32rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: var(--sp-warning-bg);
  color: var(--sp-warning);
  font-size: 24rpx;
}
.doc__title {
  font-size: 40rpx;
  font-weight: 600;
}
.doc__version {
  margin: 8rpx 0 32rpx;
  color: var(--sp-muted);
  font-size: 24rpx;
}
.doc__section {
  margin-bottom: 32rpx;
}
.doc__heading {
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.doc__body {
  color: var(--sp-text-secondary);
  font-size: 28rpx;
  line-height: 1.7;
}
