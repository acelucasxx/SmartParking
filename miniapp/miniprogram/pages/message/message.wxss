.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}
.empty {
  padding: 200rpx 48rpx 0;
  text-align: center;
}
.empty__title {
  font-size: 34rpx;
  font-weight: 600;
}
.empty__desc {
  margin-top: 16rpx;
  color: var(--sp-text-secondary);
  font-size: 26rpx;
}
.bar {
  display: flex;
  justify-content: space-between;
  margin: 0 8rpx 16rpx;
  color: var(--sp-text-secondary);
  font-size: 26rpx;
}
.bar__action {
  color: var(--sp-primary);
}
.msg {
  margin-bottom: 16rpx;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background: #fff;
}
.msg__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.msg__type {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}
.msg__title {
  flex: 1;
  overflow: hidden;
  color: var(--sp-text-secondary);
  font-size: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.msg--unread .msg__title {
  color: var(--sp-text);
  font-weight: 600;
}
.msg__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--sp-danger);
}
.msg__content {
  margin-top: 12rpx;
  color: var(--sp-text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}
.msg__foot {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  color: var(--sp-muted);
  font-size: 24rpx;
}
.msg__link {
  color: var(--sp-primary);
}
.tone--success { background: var(--sp-success-bg); color: var(--sp-success); }
.tone--info { background: var(--sp-info-bg); color: var(--sp-info); }
.tone--warning { background: var(--sp-warning-bg); color: var(--sp-warning); }
.tone--danger { background: var(--sp-danger-bg); color: var(--sp-danger); }
.tone--muted { background: var(--sp-muted-bg); color: var(--sp-muted); }
.more {
  padding: 32rpx 0;
  color: var(--sp-muted);
  font-size: 24rpx;
  text-align: center;
}
