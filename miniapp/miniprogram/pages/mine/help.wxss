.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 64rpx;
  box-sizing: border-box;
}
.list {
  border-radius: 24rpx;
  background: #fff;
  overflow: hidden;
}
.item {
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid var(--sp-muted-bg);
}
.item:last-child {
  border-bottom: none;
}
.item__q {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
}
.item__arrow {
  color: var(--sp-muted);
}
.item__a {
  margin-top: 16rpx;
  color: var(--sp-text-secondary);
  font-size: 26rpx;
  line-height: 1.7;
}
.contact {
  margin-top: 48rpx;
  text-align: center;
}
.contact__text {
  color: var(--sp-text-secondary);
  font-size: 26rpx;
}
.contact__btn {
  margin-top: 24rpx;
  border-radius: 48rpx;
  background: var(--sp-primary) !important;
  color: #fff !important;
}
