.banned {
  min-height: 100vh;
  padding: 200rpx 64rpx 64rpx;
  box-sizing: border-box;
  background: #fff;
  text-align: center;
}
.banned__icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 32rpx;
  border-radius: 50%;
  background: var(--sp-danger-bg);
  color: var(--sp-danger);
  font-size: 64rpx;
  font-weight: 700;
  line-height: 120rpx;
}
.banned__title {
  font-size: 40rpx;
  font-weight: 600;
}
.banned__desc {
  margin: 24rpx 0 80rpx;
  color: var(--sp-text-secondary);
  font-size: 28rpx;
  line-height: 1.6;
}
.banned__primary {
  border-radius: 48rpx;
  background: var(--sp-primary) !important;
  color: #fff !important;
}
.banned__secondary {
  margin-top: 24rpx;
  border-radius: 48rpx;
  background: var(--sp-muted-bg) !important;
  color: var(--sp-text) !important;
}
