.login {
  min-height: 100vh;
  padding: 160rpx 64rpx 64rpx;
  box-sizing: border-box;
  background: #fff;
}
.login__brand {
  margin-bottom: 96rpx;
  text-align: center;
}
.login__logo {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 32rpx;
  border-radius: 32rpx;
  background: var(--sp-primary);
  color: #fff;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 128rpx;
}
.login__title {
  font-size: 44rpx;
  font-weight: 600;
}
.login__subtitle,
.login__hint,
.login__status {
  margin-top: 16rpx;
  color: var(--sp-text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}
.login__hint {
  margin-bottom: 48rpx;
}
.login__primary {
  width: 100% !important;
  border-radius: 48rpx;
  background: var(--sp-primary) !important;
  color: #fff !important;
  font-size: 32rpx;
}
.login__primary--off {
  opacity: 0.5;
}
.login__notice {
  margin-top: 24rpx;
  color: var(--sp-warning);
  font-size: 26rpx;
  text-align: center;
}
.login__notice--error {
  margin-bottom: 32rpx;
  color: var(--sp-danger);
}
.login__agree {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  color: var(--sp-text-secondary);
  font-size: 24rpx;
}
.login__check {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border: 2rpx solid var(--sp-muted);
  border-radius: 50%;
}
.login__check--on {
  border-color: var(--sp-primary);
  background: var(--sp-primary);
  box-shadow: inset 0 0 0 6rpx #fff;
}
.login__link {
  color: var(--sp-primary);
}
.login__skip {
  margin-top: 48rpx;
  color: var(--sp-muted);
  font-size: 26rpx;
  text-align: center;
}
