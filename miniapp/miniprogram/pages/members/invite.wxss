.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 64rpx;
  box-sizing: border-box;
}
.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #fff;
}
.label {
  color: var(--sp-text-secondary);
  font-size: 26rpx;
}
.value {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 500;
}
.choices {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}
.choice {
  padding: 12rpx 32rpx;
  border: 2rpx solid var(--sp-border);
  border-radius: 40rpx;
  font-size: 28rpx;
}
.choice--on {
  border-color: var(--sp-primary);
  background: var(--sp-info-bg);
  color: var(--sp-primary);
}
.range {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}
.range__label {
  width: 72rpx;
  color: var(--sp-text-secondary);
  font-size: 26rpx;
}
.picker {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: var(--sp-muted-bg);
  font-size: 28rpx;
}
.hint {
  margin-top: 16rpx;
  color: var(--sp-muted);
  font-size: 24rpx;
}
.input {
  height: 80rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--sp-border);
  border-radius: 16rpx;
}
.notice {
  margin-bottom: 16rpx;
  color: var(--sp-warning);
  font-size: 26rpx;
}
.btn {
  margin-top: 24rpx;
  border-radius: 48rpx;
  background: #fff !important;
  color: var(--sp-text) !important;
}
.btn--primary {
  background: var(--sp-primary) !important;
  color: #fff !important;
}
.done {
  padding: 80rpx 32rpx 0;
  text-align: center;
}
.done__icon {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: var(--sp-success-bg);
  color: var(--sp-success);
  font-size: 56rpx;
  line-height: 112rpx;
}
.done__title {
  font-size: 36rpx;
  font-weight: 600;
}
.done__desc {
  margin-top: 16rpx;
  color: var(--sp-text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}
