.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}
.card {
  padding: 48rpx 40rpx;
  border-radius: 24rpx;
  background: #fff;
}
.card__from {
  color: var(--sp-text-secondary);
  font-size: 28rpx;
}
.card__device {
  margin: 12rpx 0 24rpx;
  font-size: 44rpx;
  font-weight: 600;
}
.card__row {
  display: flex;
  margin-top: 12rpx;
  font-size: 28rpx;
}
.card__label {
  width: 100rpx;
  color: var(--sp-text-secondary);
}
.card__notes {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--sp-border);
}
.note {
  margin-top: 12rpx;
  color: var(--sp-text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}
.notice {
  margin-top: 24rpx;
  color: var(--sp-warning);
  font-size: 26rpx;
}
.btn {
  margin-top: 24rpx;
  border-radius: 48rpx;
  background: #fff !important;
  color: var(--sp-text) !important;
}
.btn--primary {
  background: var(--sp-primary) !important;
  color: #fff !important;
}
.state {
  padding: 120rpx 32rpx 0;
  text-align: center;
}
.state__icon {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 32rpx;
  border-radius: 50%;
  background: var(--sp-warning-bg);
  color: var(--sp-warning);
  font-size: 60rpx;
  font-weight: 700;
  line-height: 112rpx;
}
.state__icon--ok {
  background: var(--sp-success-bg);
  color: var(--sp-success);
}
.state__title {
  font-size: 36rpx;
  font-weight: 600;
}
.state__device {
  margin-top: 12rpx;
  color: var(--sp-text-secondary);
}
.state__desc {
  margin: 20rpx 0 48rpx;
  color: var(--sp-text-secondary);
  line-height: 1.6;
}
