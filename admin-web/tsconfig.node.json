{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.config.ts",
    "eslint.config.js",
    "test/**/*.ts",
    "src/auth/**/*.ts",
    "src/devices/**/*.ts",
    "src/api/files.ts",
    "src/utils/**/*.ts"
  ]
}
